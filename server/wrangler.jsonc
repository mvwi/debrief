{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "debrief-server",
	"main": "src/index.ts",
	"compatibility_date": "2026-11-01",
	"vars": {
		// Public: the client id of the GitHub App. Device flow needs no secret.
		"GITHUB_CLIENT_ID": "replace-with-the-github-app-client-id"
	},
	"d1_databases": [
		{ "binding": "DB", "database_name": "debrief", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }
	],
	"r2_buckets": [
		// The bucket is made in the EU jurisdiction; a jurisdiction is fixed at creation.
		{ "binding": "BUCKET", "bucket_name": "debrief-bundles", "jurisdiction": "eu" }
	],
	"ratelimits": [
		{ "name": "AUTH_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
		{ "name": "API_LIMITER", "namespace_id": "1002", "simple": { "limit": 600, "period": 60 } }
	],
	"triggers": { "crons": ["17 * * * *"] }
}
